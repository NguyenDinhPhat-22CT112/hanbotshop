DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN_SECONDS="604800"
# Keep true on HTTPS. Set false only while the site is served directly over HTTP.
AUTH_COOKIE_SECURE="false"
# Optional shared parent domain in production, for example ".hanbotorder.vn".
# Leave empty on localhost. The session JWT is stored in a Secure HttpOnly cookie.
AUTH_COOKIE_DOMAIN=""
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional server-only API URL used by admin middleware.
API_INTERNAL_URL="http://localhost:3001/api/v1"
CLOUD_STORAGE_PROVIDER="cloudflare-r2"
CLOUD_STORAGE_BUCKET="hanbotorder"
CLOUD_STORAGE_REGION="auto"
CLOUD_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUD_STORAGE_ACCESS_KEY_ID=""
CLOUD_STORAGE_SECRET_ACCESS_KEY=""

# Optional API hardening
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
# Set to 1 only when the API is behind exactly one trusted proxy/load balancer.
TRUST_PROXY=""
# Swagger is enabled automatically outside production. In production, set true only for protected/internal docs.
ENABLE_SWAGGER=""
PAYMENT_GATEWAY_PROVIDER="manual_bank_transfer"
PAYMENT_GATEWAY_PUBLIC_KEY=""
PAYMENT_GATEWAY_SECRET_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
BANK_TRANSFER_BANK_CODE="MB"
BANK_TRANSFER_BANK_NAME="MB Bank"
BANK_TRANSFER_ACCOUNT_NUMBER="0486966775100"
BANK_TRANSFER_ACCOUNT_NAME="NGUYEN CAO PHI"
BANK_TRANSFER_QR_URL="/payment/mb-vietqr-nguyen-cao-phi.png"
BANK_TRANSFER_CONTENT_PREFIX="HANBOT"
BANK_TRANSFER_INSTRUCTIONS="Vui lòng chuyển đúng số tiền và nội dung để shop xác nhận nhanh chóng."
DEFAULT_SHIPPING_FEE=0

# Transactional email. Use "log" locally and "resend" in production.
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="Hanbotorder <orders@example.com>"
# Send HMAC-SHA256(JSON webhook payload) in this header when PAYMENT_GATEWAY_WEBHOOK_SECRET is set.
PAYMENT_GATEWAY_WEBHOOK_SIGNATURE_HEADER="x-hanbot-signature"

# Local seed and E2E accounts. Set passwords only in your ignored .env or CI secrets.
SEED_ADMIN_EMAIL="admin@hanbotorder.local"
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_EMAIL="customer@hanbotorder.local"
SEED_CUSTOMER_PASSWORD=""
