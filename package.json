{
  "name": "hanbotorder-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "dev:web": "corepack pnpm --filter @hanbotorder/web dev",
    "dev:admin": "corepack pnpm --filter @hanbotorder/admin dev",
    "dev:api": "corepack pnpm --filter @hanbotorder/api start:dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.cjs",
    "e2e:prepare": "prisma migrate deploy --schema prisma/schema.prisma && node prisma/seed.cjs",
    "test:e2e": "corepack pnpm e2e:prepare && playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@hanbotorder/eslint-config": "workspace:*",
    "@hanbotorder/tsconfig": "workspace:*",
    "@playwright/test": "1.55.1",
    "globals": "^17.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0"
  }
}
