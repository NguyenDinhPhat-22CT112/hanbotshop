NODE_ENV=production
POSTGRES_DB=hanbotorder
POSTGRES_USER=hanbotorder
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://hanbotorder:replace-with-strong-password@postgres:5432/hanbotorder?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=604800
ADMIN_IDLE_TIMEOUT_SECONDS=1800
ADMIN_SESSION_REPLACEMENT_GRACE_SECONDS=10
AUTH_COOKIE_DOMAIN=.example.com
WEB_URL=https://shop.example.com
ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://shop.example.com
API_INTERNAL_URL=http://api:3001/api/v1
PAYMENT_GATEWAY_PROVIDER=manual_bank_transfer
BANK_TRANSFER_BANK_CODE=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_CONTENT_PREFIX=HANBOT
BANK_TRANSFER_INSTRUCTIONS=
DEFAULT_SHIPPING_FEE=0
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Hanbotorder <orders@example.com>
CLOUD_STORAGE_PROVIDER=cloudflare-r2
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=auto
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_ACCESS_KEY_ID=
CLOUD_STORAGE_SECRET_ACCESS_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=1
ENABLE_SWAGGER=false
LOG_LEVEL=info
LOG_DIR=/app/logs
BACKUP_RETENTION_DAYS=14
